# ─── Database ───────────────────────────────────────────────
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/dragindrop"

# ─── Redis (rate limiting) ──────────────────────────────────
REDIS_URL="redis://127.0.0.1:6379"

# ─── Session ────────────────────────────────────────────────
SESSION_SECRET="generate-a-strong-random-string-here"

# ─── Email (Resend) ─────────────────────────────────────────
RESEND_API_KEY="re_your_api_key_here"

# ─── App ────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ─── OAuth: YouTube (Google) ──────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-your-secret"

# ─── OAuth: TikTok ────────────────────────────────────────────
TIKTOK_CLIENT_KEY="your-client-key"
TIKTOK_CLIENT_SECRET="your-client-secret"

# ─── Backblaze B2 Storage ─────────────────────────────────────
B2_ACCOUNT_ID="your-account-id"
B2_APP_KEY="your-app-key"
B2_BUCKET_ID="your-bucket-id"
B2_ENDPOINT="https://s3.eu-central-003.backblazeb2.com"

# ─── Token Encryption (AES-256-GCM) ──────────────────────────
# Generate a random 64-char hex string (32 bytes):
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY="your-64-char-hex-string"
