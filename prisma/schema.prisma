generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model PlatformPost {
  id              String             @id
  postId          String
  socialAccountId String
  platformPostId  String?
  platformUrl     String?
  status          PlatformPostStatus @default(PENDING)
  errorMessage    String?
  retryCount      Int                @default(0)
  publishedAt     DateTime?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime
  Post            Post               @relation(fields: [postId], references: [id], onDelete: Cascade)
  SocialAccount   SocialAccount      @relation(fields: [socialAccountId], references: [id], onDelete: Cascade)

  @@unique([postId, socialAccountId])
  @@index([postId])
  @@index([socialAccountId])
  @@index([status])
}

model Post {
  id            String         @id
  userId        String
  title         String         @db.VarChar(100)
  description   String?        @db.VarChar(250)
  videoFileKey  String
  videoFileName String
  videoFileSize Int
  scheduledFor  DateTime
  status        PostStatus     @default(SCHEDULED)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime
  PlatformPost  PlatformPost[]
  User          User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([scheduledFor])
  @@index([status])
  @@index([userId])
}

model RegistrationAttempt {
  id        String   @id
  ip        String
  createdAt DateTime @default(now())

  @@index([ip, createdAt])
}

model Session {
  id           String   @id
  sessionToken String   @unique
  userId       String
  expires      DateTime
  User         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SocialAccount {
  id                String         @id
  userId            String
  platform          String
  platformAccountId String
  platformUsername  String?
  accessToken       String
  refreshToken      String?
  expiresAt         DateTime?
  isActive          Boolean        @default(true)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  PlatformPost      PlatformPost[]
  User              User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, platform, platformAccountId])
  @@index([platform])
  @@index([userId])
}

model User {
  id                String              @id
  email             String              @unique
  password          String?
  emailVerified     DateTime?
  role              Role                @default(USER)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  name              String?
  image             String?
  Account           Account[]
  Post              Post[]
  Session           Session[]
  SocialAccount     SocialAccount[]
  UserPreferences   UserPreferences?
  VerificationToken VerificationToken[]
}

model UserPreferences {
  id             String   @id
  userId         String   @unique
  dateFormat     String   @default("DD/MM/YYYY")
  timeFormat     String   @default("12h")
  firstDayOfWeek String   @default("sunday")
  timezone       String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  User           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  id        String    @id
  tokenHash String    @unique
  type      TokenType
  createdAt DateTime  @default(now())
  expiresAt DateTime
  userId    String
  User      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum PlatformPostStatus {
  PENDING
  PUBLISHING
  PUBLISHED
  FAILED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  PARTIALLY_PUBLISHED
  FAILED
}

enum Role {
  USER
  ADMIN
}

enum TokenType {
  VERIFY
  RESET_PASSWORD
}
