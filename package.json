{
  "name": "dragindrop",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "next dev",
    "build": "npx prisma generate && npx prisma db push --accept-data-loss && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "db:push": "dotenv -e .env.local -- prisma db push",
    "db:generate": "dotenv -e .env.local -- prisma generate",
    "db:studio": "dotenv -e .env.local -- prisma studio",
    "postinstall": "prisma generate"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "overrides": {
    "pg": "npm:@neondatabase/serverless@^1.0.0"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.1",
    "@aws-sdk/client-s3": "^3.1020.0",
    "@aws-sdk/s3-request-presigner": "^3.1020.0",
    "@neondatabase/serverless": "^1.0.2",
    "@prisma/client": "^7.6.0",
    "bcryptjs": "^3.0.3",
    "ioredis": "^5.10.1",
    "lucide-react": "^0.555.0",
    "next": "16.1.1",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "pg": "npm:@neondatabase/serverless@^1.0.0",
    "rate-limiter-flexible": "^9.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "resend": "^6.10.0"
  },
  "devDependencies": {
    "@fast-check/vitest": "^0.3.0",
    "@prisma/config": "^7.6.0",
    "@tailwindcss/postcss": "^4.2.2",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.37",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.2",
    "baseline-browser-mapping": "^2.10.13",
    "dotenv": "^17.3.1",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.1.1",
    "fast-check": "^4.6.0",
    "jsdom": "^29.0.1",
    "prisma": "^7.6.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.2"
  }
}